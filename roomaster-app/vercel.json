{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.php": { "runtime": "vercel-php@0.7.3" }
  },
  "routes": [
    { "src": "/build/(.*)", "dest": "/public/build/$1" },
    {
      "src": "/(.*\\.(?:svg|png|jpe?g|gif|webp|avif|ico|css|js|map|woff2?|ttf|otf|mp4|webm|json|txt))",
      "dest": "/public/$1"
    },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
